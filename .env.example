# Replace these values with your hosted PostgreSQL credentials before deploying.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database-name>
SECRET_KEY=change-me-customer-secret
ADMIN_API_KEY=change-me-admin-key
EXPLORERS_ALLOW_INSECURE=true
ENVIRONMENT=development
COOKIE_SECURE=false
