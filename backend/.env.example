# Explorers Choice backend — environment configuration.
# Copy this file to `.env` and fill in real values before deploying.
#
# REQUIRED, fail-closed:
#   SECRET_KEY          — long random value signing customer sessions. Segreacted
#                         from the frontend. Generate with:
#                         python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ADMIN_API_KEY       — shared secret for admin operations in this deployment.
#
# PRODUCTION / STAGING:
#   COOKIE_SECURE       — leave unset/true (backend runs behind HTTPS).
#
# LOCAL DEVELOPMENT ONLY (never in production):
#   EXPLORERS_ALLOW_INSECURE=true   bypasses the placeholder-secret guard,
#   COOKIE_SECURE=false             cookies are sent over plain http.
#
# All developers must use the same shared PostgreSQL database. Put the real
# connection string only in the local, uncommitted `.env` file.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<shared-host>:5432/<database-name>
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:3100","https://www.explorerschoice.online","https://explorerschoice.online"]

SECRET_KEY=
ADMIN_API_KEY=

# COOKIE_SECURE=false
# EXPLORERS_ALLOW_INSECURE=true

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth ("Sign in with Google")
#
# 1. Create an OAuth 2.0 Client ID in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
#    - Application type: "Web application"
#    - Authorized redirect URIs: add the GOOGLE_REDIRECT_URI value below
#
# 2. Copy GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET into your local .env.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# GOOGLE_RETURN_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Email Notifications (Tour Bookings & Admin Alerts)
#
# Recipient email address for booking notifications (defaults to infoexplorerschoice@gmail.com):
ADMIN_NOTIFICATION_EMAIL=infoexplorerschoice@gmail.com

# SMTP settings for sending emails (e.g. Gmail, SendGrid, Amazon SES, Mailgun, etc.):
# For Gmail:
#   1. Enable 2-Step Verification in your Google Account
#   2. Generate an "App Password" at https://myaccount.google.com/apppasswords
#   3. Put your Gmail in SMTP_USERNAME and the 16-character App Password in SMTP_PASSWORD
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=infoexplorerschoice@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=infoexplorerschoice@gmail.com
SMTP_FROM_NAME=Explorers Choice
SMTP_USE_TLS=true
SMTP_USE_SSL=false